# Google Gemini API
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="AQ.Ab8RN6JlgFht5OlHqMFEaX_jrC2S-4pkxS1GQ5PehtZeEkxChA"

# Transkribus API
# Register at: https://transkribus.eu/
TRANSKRIBUS_USERNAME="imanuelcaleb24aid@vetias.ac.in"
TRANSKRIBUS_PASSWORD="vetias@aid"

# OCR Engine Selection: "gemini" | "transkribus" | "auto"
# "auto" tries engines in priority order until one succeeds
OCR_ENGINE=auto

# Primary engine priority when using "auto" mode
# Comma-separated list: transkribus,gemini
OCR_ENGINE_PRIORITY=transkribus,gemini